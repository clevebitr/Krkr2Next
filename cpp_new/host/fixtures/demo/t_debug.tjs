Debug.message("debug message ok");
Debug.message("a", 1, "b");
if(Debug.logLocation != "") throw new Exception("logLocation default is not empty");
Debug.logLocation = "build/debug_probe.log";
if(Debug.logLocation != "build/debug_probe.log") throw new Exception("logLocation roundtrip failed");
if(Debug.logToFileOnError != 0) throw new Exception("logToFileOnError default");
Debug.logToFileOnError = 1;
if(Debug.logToFileOnError != 1) throw new Exception("logToFileOnError roundtrip");
if(Debug.clearLogFileOnError != 0) throw new Exception("clearLogFileOnError default");
if(typeof Debug.console != "Object") throw new Exception("console is missing");
if(Debug.console.visible != 0) throw new Exception("console.visible must report 0");
Debug.console.visible = 1;
if(Debug.console.visible != 0) throw new Exception("console.visible must stay 0");
if(typeof Debug.controller != "Object") throw new Exception("controller is missing");
var last = Debug.getLastLog(8);
if(typeof last != "String") throw new Exception("getLastLog type");
if(last.indexOf("debug message ok") < 0) throw new Exception("getLastLog missed the message");
Debug.startLogToFile(false);
Debug.notice("notice ok");
Debug.logAsError();
throw new Exception("debug-ok");
