{
  "version": 6,
  "configurePresets": [
    {
      "name": "desktop-debug",
      "displayName": "Desktop Debug (cpp_new)",
      "binaryDir": "${sourceDir}/../build/cmake/debug",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "desktop-release",
      "displayName": "Desktop Release (cpp_new)",
      "binaryDir": "${sourceDir}/../build/cmake/release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-debug",
      "displayName": "Android arm64 Debug (cpp_new)",
      "binaryDir": "${sourceDir}/../build/cmake/android-debug",
      "generator": "Ninja",
      "toolchainFile": "$env{KRKR_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Debug",
        "KRKR_BUILD_TOOLS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug"
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release"
    },
    {
      "name": "android-debug",
      "configurePreset": "android-debug"
    }
  ],
  "testPresets": [
    {
      "name": "desktop-debug",
      "configurePreset": "desktop-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-release",
      "configurePreset": "desktop-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "android-debug",
      "configurePreset": "android-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
