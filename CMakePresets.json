{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Android Config",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "ANDROID": true,
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg/triplets",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TOOLS": false,
        "ENABLE_TESTS": false
      }
    },
    {
      "name": "Android Debug Config",
      "inherits": "Android Config",
      "binaryDir": "${sourceDir}/out/android/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Android Release Config",
      "inherits": "Android Config",
      "binaryDir": "${sourceDir}/out/android/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Linux Config",
      "generator": "Ninja",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TOOLS": true,
        "ENABLE_TESTS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Linux Debug Config",
      "inherits": "Linux Config",
      "binaryDir": "${sourceDir}/out/linux/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux Release Config",
      "inherits": "Linux Config",
      "binaryDir": "${sourceDir}/out/linux/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Android Debug Build",
      "configurePreset": "Android Debug Config"
    },
    {
      "name": "Android Release Build",
      "configurePreset": "Android Release Config"
    },
    {
      "name": "Linux Debug Build",
      "configurePreset": "Linux Debug Config"
    },
    {
      "name": "Linux Release Build",
      "configurePreset": "Linux Release Config"
    }
  ]
}
