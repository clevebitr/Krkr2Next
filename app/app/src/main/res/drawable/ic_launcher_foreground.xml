<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标的**前景层**：只有 "K" 折角，没有底。

    尺寸规矩（Android 自适应图标规范）：
      * 视图是 108×108，但启动器只显示**中心 72×72**，并且会用圆形/方形/圆角方形的
        遮罩把它裁出来；
      * 中心直径 **66 的圆**才是安全区，超出的部分可能被裁掉。
    所以这里不画底、不画圆角，也不把图形撑满 108——"K" 占 x∈[34,77]、y∈[28,80]，
    离中心 (55.5, 54) 最远约 34.7，落在 72 圆的半径 36 以内，圆遮罩下也不会缺角。

    背景层是同名的 @color/ic_launcher_background，形状由遮罩决定。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/ic_launcher_foreground"
        android:pathData="M34,28 H44 V50 L64,28 H76 L54,52 L77,80 H64 L44,56 V80 H34 Z" />
</vector>
