<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        引擎通过 engine_open_game(path) 消费**裸文件系统路径**，content:// URI
        无法直接解析为真实路径，因此不用 SAF，改用全文件访问权限。
        API 24-28 走 READ_EXTERNAL_STORAGE + requestLegacyExternalStorage；
        API 30+ 引导用户在系统设置里授予 MANAGE_EXTERNAL_STORAGE。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        刮削（VNDB）与封面下载需要联网。**没有它刮削功能只会报"无法连接"**，
        而这类失败在模拟器/断网时看起来像是代码 bug，所以权限就写在这里说清楚。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ANGLE 已移除，走平台自带的 GLES 驱动 -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:name=".KrKr2NextApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.KrKr2Next"
        tools:targetApi="q">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            崩溃界面必须跑在独立进程里：它是在主进程即将被 killProcess 掉的时刻被拉起来
            的，同进程的话它一出生就会被一起杀掉。代价是拿不到内存状态，因此它只读崩溃
            报告文件。taskAffinity="" + excludeFromRecents 让它不进最近任务、也不搅乱
            主进程的任务栈。
        -->
        <activity
            android:name=".CrashActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:process=":crash"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity=""
            android:theme="@style/Theme.KrKr2Next" />

        <!--
            供「分享日志」把 logs/ 下的文件以 content:// 交给别的应用。
            只读授权、exported=false，白名单见 res/xml/file_paths.xml。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
